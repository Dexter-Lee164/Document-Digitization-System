<%
  const navItems = [
    { key: 'dashboard', href: '/dashboard', icon: 'grid-1x2', label: 'Dashboard' },
    { key: 'scan', href: '/scan/new', icon: 'camera', label: 'New Scan' },
    { key: 'documents', href: '/documents', icon: 'files', label: 'My Documents' },
    { key: 'history', href: '/history', icon: 'clock-history', label: 'History' },
    { key: 'lab', href: '/lab', icon: 'activity', label: 'DSP Lab' },
    { key: 'settings', href: '/settings', icon: 'gear', label: 'Settings' }
  ];
  const cssFiles = locals.pageCss || [];
  const crumbList = locals.crumbs || [];
%><!doctype html>
<html lang="en" data-sidebar="expanded">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> - DocuVision</title>
  <link rel="icon" href="/static/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/main.css">
<% cssFiles.forEach(function (f) { %>  <link rel="stylesheet" href="/static/css/<%= f %>">
<% }) %>  <script src="/static/js/boot.js"></script>
</head>
<body class="dv-body">
<a class="dv-skip visually-hidden-focusable" href="#main">Skip to content</a>

<aside class="dv-sidebar" id="sidebar" aria-label="Main navigation">
  <a class="dv-brand" href="/dashboard" aria-label="DocuVision home">
    <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#2563EB"/><g fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V9.5A1.5 1.5 0 0 1 9.5 8H13"/><path d="M19 8h3.5A1.5 1.5 0 0 1 24 9.5V13"/><path d="M24 19v3.5a1.5 1.5 0 0 1-1.5 1.5H19"/><path d="M13 24H9.5A1.5 1.5 0 0 1 8 22.5V19"/></g><path d="M11.5 16h9" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
    <span class="dv-brand-name">DocuVision</span>
  </a>
  <ul class="dv-nav">
    <% navItems.forEach(function (item) { %>
    <li>
      <a class="dv-nav-link<%= locals.nav === item.key ? ' active' : '' %>" href="<%= item.href %>" title="<%= item.label %>"<%- locals.nav === item.key ? ' aria-current="page"' : '' %>>
        <i class="bi bi-<%= item.icon %>" aria-hidden="true"></i><span class="dv-nav-label"><%= item.label %></span>
      </a>
    </li>
    <% }) %>
  </ul>
  <div class="dv-sidebar-foot">
    <form method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="dv-nav-link" title="Sign out"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="dv-nav-label">Sign out</span></button>
    </form>
  </div>
</aside>
<div class="dv-backdrop" data-sidebar-close></div>

<div class="dv-content">
  <header class="dv-topbar">
    <button type="button" class="dv-icon-btn dv-mobile-only" data-sidebar-open aria-label="Open navigation"><i class="bi bi-list"></i></button>
    <button type="button" class="dv-icon-btn dv-desktop-only" data-sidebar-toggle aria-label="Collapse or expand the sidebar" title="Collapse or expand the sidebar"><i class="bi bi-layout-sidebar-inset"></i></button>
    <nav aria-label="Breadcrumb">
      <ol class="dv-crumbs">
        <% crumbList.forEach(function (c) { %>
          <% if (c.href) { %><li><a href="<%= c.href %>"><%= c.label %></a></li><% } else { %><li aria-current="page"><%= c.label %></li><% } %>
        <% }) %>
        <% if (!crumbList.length) { %><li aria-current="page"><%= title %></li><% } %>
      </ol>
    </nav>
    <div class="dv-topbar-end">
      <span class="dv-status" id="service-status" role="status"><span class="dv-status-text">Checking services</span></span>
      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-person-circle me-1" aria-hidden="true"></i><span class="d-none d-md-inline dv-ellipsis" style="max-width:18ch"><%= locals.user ? locals.user.email : '' %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><span class="dropdown-item-text text-slate small"><%= locals.user ? locals.user.email : '' %></span></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/settings"><i class="bi bi-gear me-2" aria-hidden="true"></i>Settings</a></li>
          <li>
            <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button></form>
          </li>
        </ul>
      </div>
    </div>
  </header>
  <main id="main" class="dv-main" tabindex="-1">
