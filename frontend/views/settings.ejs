<%- include('partials/head') %>
<div class="dv-page-head">
  <div>
    <h1>Settings</h1>
    <p>Defaults for new scans and Word exports, your password, and the status of the local services.</p>
  </div>
</div>

<div class="row g-3" id="settings" data-preset="<%= settings.default_preset %>" data-type="<%= settings.default_document_type %>" data-reflow="<%= settings.export_reflow ? 1 : 0 %>" data-fulltext="<%= settings.export_include_full_text ? 1 : 0 %>">
  <div class="col-lg-7 d-flex flex-column gap-3">
    <section class="dv-panel">
      <div class="dv-panel-head"><h2>Defaults</h2></div>
      <form class="dv-panel-body d-grid gap-3" id="defaults-form" novalidate>
        <div>
          <label class="form-label" for="s-preset">Enhancement preset for new scans</label>
          <select class="form-select" id="s-preset">
            <option value="automatic">Automatic</option><option value="document_scan">Document scan</option><option value="black_white">Black and white</option><option value="grayscale">Grayscale</option>
          </select>
        </div>
        <div>
          <label class="form-label" for="s-type">Document type for new scans</label>
          <select class="form-select" id="s-type"><option value="general">General document</option><option value="form">Structured form</option></select>
        </div>
        <hr class="my-1">
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="s-reflow"><label class="form-check-label" for="s-reflow">Join wrapped lines into paragraphs in Word exports</label></div>
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="s-fulltext"><label class="form-check-label" for="s-fulltext">Include the rest of the page text under form tables</label></div>
        <div>
          <label class="form-label" for="s-suffix">Added to export file names</label>
          <input class="form-control" id="s-suffix" maxlength="40" value="<%= settings.export_filename_suffix %>" autocomplete="off" style="max-width:260px">
          <div class="form-text">For example, "report" becomes "report_digitized.docx".</div>
        </div>
        <div id="defaults-error" class="dv-notice dv-notice-bad d-none" role="alert"></div>
        <div><button class="btn btn-primary" type="submit">Save defaults</button></div>
      </form>
    </section>

    <section class="dv-panel">
      <div class="dv-panel-head"><h2>Change password</h2></div>
      <form class="dv-panel-body d-grid gap-3" id="password-form" novalidate autocomplete="off">
        <div><label class="form-label" for="pw-current">Current password</label><input class="form-control" type="password" id="pw-current" autocomplete="current-password" style="max-width:360px"></div>
        <div><label class="form-label" for="pw-new">New password</label><input class="form-control" type="password" id="pw-new" autocomplete="new-password" style="max-width:360px"><div class="form-text">At least 8 characters with a letter and a number.</div></div>
        <div><label class="form-label" for="pw-confirm">Confirm new password</label><input class="form-control" type="password" id="pw-confirm" autocomplete="new-password" style="max-width:360px"></div>
        <div id="password-error" class="dv-notice dv-notice-bad d-none" role="alert"></div>
        <div><button class="btn btn-primary" type="submit">Change password</button></div>
      </form>
    </section>
  </div>

  <div class="col-lg-5 d-flex flex-column gap-3">
    <section class="dv-panel">
      <div class="dv-panel-head"><h2>Account</h2></div>
      <div class="dv-panel-body">
        <dl class="dv-kv mb-0">
          <dt>Email</dt><dd><%= user.email %></dd>
          <dt>Member since</dt><dd><%= new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></dd>
        </dl>
      </div>
    </section>
    <section class="dv-panel">
      <div class="dv-panel-head"><h2>Services on this computer</h2><button class="btn btn-sm btn-outline-secondary" type="button" id="btn-recheck">Check again</button></div>
      <div class="dv-panel-body" id="services"><p class="text-slate small mb-0">Checking...</p></div>
    </section>
  </div>
</div>
<%- include('partials/foot', { scripts: ['settings.js'] }) %>
