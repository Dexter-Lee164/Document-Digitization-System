# ----------------------------------------------------------------------------
# DocuVision configuration.  Copy to .env (scripts/setup.ps1 or `npm run setup:env`
# does this for you and generates the two secrets below).  Never commit .env.
# ----------------------------------------------------------------------------

# --- Web application (Node.js / Express) ---
PORT=3000
# Interface to bind. 127.0.0.1 = this computer only (recommended; browsers also only allow camera access on localhost/HTTPS).
HOST=127.0.0.1
NODE_ENV=development
# Long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=
# Set to true only when the site is served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=false
# bcrypt cost factor for password hashing (10-14 sensible; higher = slower logins).
BCRYPT_ROUNDS=12

# --- SQLite database and private file storage (relative paths are resolved from the project root) ---
DATABASE_PATH=./data/docuvision.sqlite
STORAGE_PATH=./storage

# --- Uploads ---
# Maximum upload size in bytes (default 10 MB).
MAX_UPLOAD_SIZE=10485760
# Maximum decoded image size in pixels (default 40 megapixels). Enforced by both services.
MAX_IMAGE_PIXELS=40000000

# --- Python computer-vision / OCR service (FastAPI) ---
CV_SERVICE_URL=http://127.0.0.1:8001
# Shared secret between Node.js and the CV service. REQUIRED. (generated by setup)
CV_SERVICE_TOKEN=
# Host/port the CV service binds to (keep 127.0.0.1: it must never be exposed publicly).
CV_HOST=127.0.0.1
CV_PORT=8001
# Per-request timeout used by Node when calling the CV service, in milliseconds.
CV_TIMEOUT_MS=180000
# Maximum number of heavy CV jobs the service runs at the same time.
CV_MAX_CONCURRENCY=2

# --- Tesseract OCR ---
# Full path to tesseract.exe on Windows. Leave empty to auto-detect (PATH, then C:\Program Files\Tesseract-OCR).
TESSERACT_CMD=
# Seconds before a single OCR run is aborted.
OCR_TIMEOUT_SECONDS=90

# --- Optional ---
# Python interpreter used by "npm run dev" and "npm run start:cv". Leave empty to use the project's .venv,
# then "py -3.12" / "py -3.11" / "python" on PATH.
# CV_PYTHON=C:\path\to\python.exe
